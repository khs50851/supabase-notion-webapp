# Supabase (인증 + PostgreSQL DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 구글 로그인(OAuth)은 별도 env var가 필요 없습니다 — Supabase Dashboard의
# Authentication > Providers > Google에서 Client ID/Secret을 등록하면 바로 동작합니다.

# Notion 연동
# 참고: 데이터 모델상 notion_api_key / notion_database_id는 Account(관리자)별로 노션 연동
# 설정 페이지(F001)에서 입력받아 DB에 저장하는 값입니다. 아래 변수는 로컬 개발 시 기본값
# 또는 테스트 용도로만 사용하세요.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# 개발용 임시 관리자 로그인 (Supabase 미연동 상태에서만 사용됨)
# Supabase 프로젝트 연결 전, 실제 인증 없이 관리자 화면(대시보드/노션 연동 설정)을 로그인해서
# 테스트하기 위한 자격증명입니다. 미설정 시 기본값은 admin / 1234 입니다.
# ⚠️ Supabase가 연동되면(NEXT_PUBLIC_SUPABASE_*) 이 분기 자체가 비활성화되므로 프로덕션에는
# 영향이 없습니다. 그래도 실제 배포 환경에는 이 값을 채우지 마세요.
DEV_ADMIN_EMAIL=admin
DEV_ADMIN_PASSWORD=1234
